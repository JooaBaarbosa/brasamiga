# Copie este arquivo para .env e troque a senha.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Tamanho máximo de cada foto/vídeo enviado pelo painel, em MB.
MAX_UPLOAD_MB=300

# Opcional: onde ficam o banco e os uploads (padrão: ./data) e a pasta de conteúdo (padrão: ./conteudo).
# BRASAMIGA_DATA_DIR=./data
# BRASAMIGA_CONTENT_DIR=./conteudo
